<script>
  (function() {
    // 1. Audio toggle
    const playBtn = document.getElementById('audio-toggle-btn');
    const playIcon = document.getElementById('audio-play-icon');
    let isPlaying = true;

    if (playBtn && playIcon) {
      playBtn.addEventListener('click', function() {
        isPlaying = !isPlaying;
        playIcon.textContent = isPlaying ? 'pause' : 'play_arrow';
      });
    }

    // 2. Light / Dark Mode Toggle
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIcon = document.getElementById('theme-toggle-icon');
    const htmlElement = document.documentElement;

    if (themeBtn && themeIcon) {
      themeBtn.addEventListener('click', function() {
        const isDark = htmlElement.classList.contains('dark');
        if (isDark) {
          htmlElement.classList.remove('dark');
          themeIcon.textContent = 'dark_mode';
          themeBtn.setAttribute('aria-label', 'Ativar Modo Escuro');
        } else {
          htmlElement.classList.add('dark');
          themeIcon.textContent = 'light_mode';
          themeBtn.setAttribute('aria-label', 'Ativar Modo Claro');
        }
      });
    }
  })();
