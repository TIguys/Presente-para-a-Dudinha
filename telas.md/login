<!DOCTYPE html>

<html class="dark" lang="pt-BR"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" name="viewport"/>
<meta content="mobile_blank" name="shell-type"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;1,400&amp;family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "on-error-container": "#ffdad6",
            "outline-variant": "#414751",
            "surface-container": "#122033",
            "on-surface": "#d5e3fe",
            "secondary-container": "#8d1a32",
            "surface-container-lowest": "#010e21",
            "surface-container-low": "#0d1c2f",
            "on-secondary-container": "#ff9da5",
            "on-primary-fixed": "#001c39",
            "on-error": "#690005",
            "secondary-fixed": "#ffdadb",
            "background": "#051427",
            "surface-variant": "#28354a",
            "on-surface-variant": "#c1c7d3",
            "primary": "#a4c9ff",
            "on-primary-fixed-variant": "#004883",
            "outline": "#8b919d",
            "surface-bright": "#2c3a4e",
            "surface-container-high": "#1d2b3e",
            "surface-tint": "#a4c9ff",
            "surface-container-highest": "#28354a",
            "error": "#ffb4ab",
            "surface": "#051427",
            "primary-container": "#4d93e5",
            "on-primary": "#00315d"
          },
          fontFamily: {
            "headline-lg": ["Playfair Display", "serif"],
            "headline-md": ["Playfair Display", "serif"],
            "body-md": ["Montserrat", "sans-serif"],
            "body-sm": ["Montserrat", "sans-serif"],
            "label-lg": ["Montserrat", "sans-serif"],
            "label-sm": ["Montserrat", "sans-serif"]
          }
        }
      }
    };
  </script>
<style>
    @layer base {
      html.dark body {
        background-color: #051427;
        color: #d5e3fe;
      }
      html:not(.dark) body {
        background-color: #fbf9f6;
        color: #1a2230;
      }
      .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }
      .pt-safe { padding-top: env(safe-area-inset-top, 0px); }
    }
  </style>
</head>
<body class="font-body-md text-body-md flex flex-col min-h-screen pt-safe pb-safe antialiased transition-colors duration-300">
<!-- Top Navigation / Theme Toggle Header -->
<header class="w-full max-w-md mx-auto px-6 pt-5 pb-2 flex items-center justify-end">
<button aria-label="Alternar tema claro/escuro" class="p-2.5 rounded-full text-slate-400 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white bg-slate-200/50 dark:bg-slate-800/60 backdrop-blur-md border border-slate-300/40 dark:border-white/10 transition-all duration-300 active:scale-95" id="theme-toggle" onclick="toggleTheme()">
<!-- Sun Icon (visible in dark mode) -->
<svg class="w-5 h-5 block dark:block" fill="none" id="sun-icon" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24">
<circle cx="12" cy="12" r="5"></circle>
<line x1="12" x2="12" y1="1" y2="3"></line>
<line x1="12" x2="12" y1="21" y2="23"></line>
<line x1="4.22" x2="5.64" y1="4.22" y2="5.64"></line>
<line x1="18.36" x2="19.78" y1="18.36" y2="19.78"></line>
<line x1="1" x2="3" y1="12" y2="12"></line>
<line x1="21" x2="23" y1="12" y2="12"></line>
<line x1="4.22" x2="5.64" y1="19.78" y2="18.36"></line>
<line x1="18.36" x2="19.78" y1="5.64" y2="4.22"></line>
</svg>
<!-- Moon Icon (visible in light mode) -->
<svg class="w-5 h-5 hidden dark:hidden" fill="none" id="moon-icon" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24">
<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
</svg>
</button>
</header>
<!-- Main Minimalist Viewport Content -->
<main class="flex flex-col relative w-full flex-1 px-6 justify-center items-center">
<div class="flex flex-col w-full max-w-xs sm:max-w-sm mx-auto items-center justify-center -mt-6">
<!-- Minimal Editorial Monogram Header -->
<div class="text-center mb-8">
<h1 class="font-headline-lg text-4xl sm:text-5xl text-slate-900 dark:text-slate-100 tracking-tight mb-2">
          Para Sempre
        </h1>
<p class="font-body-md text-sm text-slate-500 dark:text-slate-400 italic">
          Um lugar só nosso.
        </p>
</div>
<!-- Pure Minimal Card -->
<div class="w-full bg-white/70 dark:bg-surface-container-low/80 backdrop-blur-xl border border-slate-200/80 dark:border-white/5 rounded-2xl p-6 sm:p-7 shadow-xl shadow-slate-900/5 dark:shadow-black/40 transition-all duration-300">
<form class="flex flex-col gap-4" id="auth-form" onsubmit="event.preventDefault(); handleLogin();">
<!-- Usuário -->
<div class="flex flex-col gap-1.5">
<label class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400 ml-0.5" for="username">
              Usuário
            </label>
<div class="relative flex items-center w-full">
<span class="absolute left-3.5 flex items-center justify-center text-slate-400 dark:text-slate-500 pointer-events-none">
<svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24" width="16">
<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
<circle cx="12" cy="7" r="4"></circle>
</svg>
</span>
<input autocomplete="username" class="w-full bg-slate-50/80 dark:bg-slate-950/60 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 pl-10 pr-3.5 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500/70 dark:focus:border-primary/70 transition-all" id="username" name="username" placeholder="Identificação íntima" required="" type="text"/>
</div>
</div>
<!-- Senha -->
<div class="flex flex-col gap-1.5">
<label class="text-xs uppercase tracking-wider font-semibold text-slate-500 dark:text-slate-400 ml-0.5" for="password">
              Senha
            </label>
<div class="relative flex items-center w-full">
<span class="absolute left-3.5 flex items-center justify-center text-slate-400 dark:text-slate-500 pointer-events-none">
<svg fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24" width="16">
<rect height="11" rx="2" ry="2" width="18" x="3" y="11"></rect>
<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
</svg>
</span>
<input autocomplete="current-password" class="w-full bg-slate-50/80 dark:bg-slate-950/60 border border-slate-200 dark:border-white/10 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 pl-10 pr-10 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-500/70 dark:focus:border-primary/70 transition-all" id="password" name="password" placeholder="Chave secreta" required="" type="password"/>
<button aria-label="Revelar senha" class="absolute right-3.5 flex items-center justify-center text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 transition-colors" id="toggle-password" onclick="togglePasswordVisibility()" type="button">
<svg fill="none" height="16" id="eye-icon" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24" width="16">
<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
<circle cx="12" cy="12" r="3"></circle>
</svg>
<svg class="hidden" fill="none" height="16" id="eye-off-icon" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24" width="16">
<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
<path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
<path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
<line x1="2" x2="22" y1="2" y2="22"></line>
</svg>
</button>
</div>
</div>
<!-- Alert / Feedback Notification -->
<div class="hidden flex items-center gap-2 p-2.5 rounded-lg text-xs transition-all duration-300" id="auth-alert">
<span id="auth-alert-message"></span>
</div>
<!-- Submit Button -->
<button class="w-full mt-2 bg-slate-900 text-white dark:bg-blue-500 dark:text-slate-950 font-medium text-sm py-2.5 px-4 rounded-xl shadow-md hover:opacity-95 active:scale-[0.98] transition-all flex items-center justify-center gap-2" id="btn-submit" type="submit">
<span>Entrar</span>
<svg fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="15">
<polyline points="9 18 15 12 9 6"></polyline>
</svg>
</button>
</form>
</div>
</div>
</main>
<script>
    // Theme toggle logic
    function updateThemeIcons(isDark) {
      const sunIcon = document.getElementById('sun-icon');
      const moonIcon = document.getElementById('moon-icon');
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }

    function toggleTheme() {
      const html = document.documentElement;
      const isCurrentlyDark = html.classList.contains('dark');
      if (isCurrentlyDark) {
        html.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        updateThemeIcons(false);
      } else {
        html.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        updateThemeIcons(true);
      }
    }

    // Initialize theme based on preference or current class
    (function initTheme() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
        updateThemeIcons(false);
      } else {
        document.documentElement.classList.add('dark');
        updateThemeIcons(true);
      }
    })();

    // Password visibility toggle
    function togglePasswordVisibility() {
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eye-icon');
      const eyeOffIcon = document.getElementById('eye-off-icon');

      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.add('hidden');
        eyeOffIcon.classList.remove('hidden');
      } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('hidden');
        eyeOffIcon.classList.add('hidden');
      }
    }

    // Login action feedback
    function handleLogin() {
      const alertBox = document.getElementById('auth-alert');
      const alertMsg = document.getElementById('auth-alert-message');
      const btnSubmit = document.getElementById('btn-submit');

      btnSubmit.disabled = true;
      btnSubmit.classList.add('opacity-75');

      setTimeout(() => {
        btnSubmit.disabled = false;
        btnSubmit.classList.remove('opacity-75');

        alertBox.className = 'flex items-center gap-2 p-2.5 rounded-lg text-xs bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
        alertMsg.textContent = 'Acesso reservado reconhecido. Conectando...';
        alertBox.classList.remove('hidden');
      }, 500);
    }
  </script>
</body></html>
